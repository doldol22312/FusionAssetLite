<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#F1F4F0</Color>
    <Color x:Key="ChromeColor">#E8ECE7</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="WellColor">#F7F9F6</Color>
    <Color x:Key="ChipColor">#EEF2ED</Color>
    <Color x:Key="ChipHoverColor">#E3E9E2</Color>
    <Color x:Key="BorderColor">#D9E0D7</Color>
    <Color x:Key="BorderStrongColor">#BFC8BD</Color>

    <Color x:Key="InkColor">#181D1B</Color>
    <Color x:Key="SubInkColor">#4C5752</Color>
    <Color x:Key="MutedColor">#6F7B75</Color>

    <Color x:Key="AccentColor">#0D826A</Color>
    <Color x:Key="AccentHoverColor">#0B9478</Color>
    <Color x:Key="AccentDarkColor">#096351</Color>
    <Color x:Key="AccentSoftColor">#E4F4EF</Color>
    <Color x:Key="AccentBorderColor">#9ED5C5</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="{StaticResource ChipHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="SubInkBrush" Color="{StaticResource SubInkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />

    <SolidColorBrush x:Key="ImagesAccentBrush" Color="#0D826A" />
    <SolidColorBrush x:Key="SoundsAccentBrush" Color="#2574C7" />
    <SolidColorBrush x:Key="PackedAccentBrush" Color="#C27812" />
    <SolidColorBrush x:Key="ShadersAccentBrush" Color="#6358D8" />

    <SolidColorBrush x:Key="StatusIdleBrush" Color="#8C9690" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0D826A" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#C27812" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC2626" />

    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />

    <SolidColorBrush x:Key="DropOverlayBgBrush" Color="#DCF1F4F0" />
    <SolidColorBrush x:Key="ButtonHoverTintBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ButtonPressedTintBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <SolidColorBrush x:Key="LogBgBrush" Color="#11161B" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#D4DCE6" />
    <SolidColorBrush x:Key="LogHeaderBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="LogMutedBrush" Color="#8896A6" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F87171" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3B4654" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#526174" />
</ResourceDictionary>
