<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#0D1115</Color>
    <Color x:Key="ChromeColor">#0A0D10</Color>
    <Color x:Key="CardColor">#141920</Color>
    <Color x:Key="WellColor">#0D1116</Color>
    <Color x:Key="ChipColor">#1A212B</Color>
    <Color x:Key="ChipHoverColor">#222B38</Color>
    <Color x:Key="BorderColor">#232C37</Color>
    <Color x:Key="BorderStrongColor">#323E4D</Color>

    <Color x:Key="InkColor">#EDF2F7</Color>
    <Color x:Key="SubInkColor">#9AA7B5</Color>
    <Color x:Key="MutedColor">#6C7987</Color>

    <Color x:Key="AccentColor">#18A97E</Color>
    <Color x:Key="AccentHoverColor">#1EC191</Color>
    <Color x:Key="AccentDarkColor">#117C5C</Color>
    <Color x:Key="AccentSoftColor">#102B24</Color>
    <Color x:Key="AccentBorderColor">#1F5949</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="{StaticResource ChipHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="SubInkBrush" Color="{StaticResource SubInkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />

    <SolidColorBrush x:Key="ImagesAccentBrush" Color="#1EC191" />
    <SolidColorBrush x:Key="SoundsAccentBrush" Color="#47A8F5" />
    <SolidColorBrush x:Key="PackedAccentBrush" Color="#E5A238" />
    <SolidColorBrush x:Key="ShadersAccentBrush" Color="#9388FA" />

    <SolidColorBrush x:Key="StatusIdleBrush" Color="#6C7987" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#22C58B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E59A28" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF5B5B" />

    <SolidColorBrush x:Key="DangerBgBrush" Color="#261517" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5B292D" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171" />

    <SolidColorBrush x:Key="DropOverlayBgBrush" Color="#D80B1014" />
    <SolidColorBrush x:Key="ButtonHoverTintBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedTintBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <SolidColorBrush x:Key="LogBgBrush" Color="#0B0F14" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#D4DCE6" />
    <SolidColorBrush x:Key="LogHeaderBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="LogMutedBrush" Color="#8896A6" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F87171" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2D3744" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#435265" />
</ResourceDictionary>
